# Mode de Trading
PAPER_TRADING=true
TRADING_INTERVAL=10
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,AVAX/USDT,BNB/USDT,ADA/USDT,DOT/USDT,MATIC/USDT

# Paramètres de Risque
MAX_POSITION_SIZE=1000
MAX_DAILY_LOSS=500
MAX_LEVERAGE=3

# Clés API LLM
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=xxx
GROK_API_KEY=xxx
GEMINI_API_KEY=xxx
DEEPSEEK_API_KEY=xxx
NVIDIA_API_KEY=xxx

# Clés API Exchange (Testnet recommandé en premier !)
BINANCE_API_KEY=xxx
BINANCE_API_SECRET=xxx
BYBIT_API_KEY=xxx
BYBIT_API_SECRET=xxx
OKX_API_KEY=xxx
OKX_API_SECRET=xxx
OKX_PASSPHRASE=xxx

# Base de données
DATABASE_URL=postgresql://trader:password@postgres:5432/vodstrade
REDIS_URL=redis://redis:6379

# Configuration des Agents
AGENT_COUNT=500
MARKET_RESEARCH_AGENTS=50
SENTIMENT_AGENTS=100
TECHNICAL_AGENTS=50
FUNDAMENTAL_AGENTS=40
ONCHAIN_AGENTS=40
NEWS_AGENTS=50
SOCIAL_AGENTS=100
RISK_AGENTS=30
STRATEGY_AGENTS=40
EXECUTION_AGENTS=50

# Configuration ML
USE_GPU=true
LSTM_HIDDEN_SIZE=128
TRANSFORMER_LAYERS=3
